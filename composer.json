{
    "$schema": "https://getcomposer.org/schema.json",
    "name": "weave-php/blocknote-filament",
    "description": "Weave BlockNote rich-text editor as a Filament form field for Laravel.",
    "type": "library",
    "keywords": [
        "laravel",
        "filament",
        "blocknote",
        "editor",
        "weave"
    ],
    "license": "MIT",
    "authors": [
        {
            "name": "Weave PHP",
            "email": "hello@weave-php.dev"
        }
    ],
    "require": {
        "php": "^8.3",
        "filament/filament": "^3.0 || ^4.0 || ^5.0",
        "spatie/laravel-package-tools": "^1.16"
    },
    "require-dev": {
        "orchestra/testbench": "^9.0|^10.0|^11.0",
        "phpunit/phpunit": "^11.0|^12.0"
    },
    "autoload": {
        "psr-4": {
            "Weave\\BlockNote\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Weave\\BlockNote\\Tests\\": "tests/"
        }
    },
    "extra": {
        "laravel": {
            "providers": [
                "Weave\\BlockNote\\BlockNoteServiceProvider"
            ]
        }
    },
    "config": {
        "sort-packages": true
    },
    "minimum-stability": "stable",
    "prefer-stable": true
}
